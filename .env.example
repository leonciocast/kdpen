# AI mystery cases (Amazon Bedrock). Copy to .env.local (git-ignored) and fill in.
# The server reads these; nothing here is ever sent to the browser.

# Region you call Bedrock from (the "us." profile routes within the US).
AWS_REGION=us-east-1
# Claude Sonnet 5.5, US cross-Region inference profile. Use global.anthropic.claude-sonnet-5-5 for ~10% lower price (any region).
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5

# Credentials for an IAM user that may only call this model (see docs/ai-cases.md).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# …or instead: AWS_PROFILE=kdpen   (a profile in ~/.aws/credentials)

# Optional
# BEDROCK_MOCK=1            # test mode: no AWS calls, stories come from templates
# BEDROCK_TOOL_CHOICE=auto  # auto | tool (force the JSON tool where the model allows it)
# AI_RATE_LIMIT=20          # requests per IP per 10 minutes
# AI_JOB_TIMEOUT_MS=1200000 # give up on a book after 20 minutes
# BEDROCK_PRICE_IN=2.2      # USD per million input tokens (for the cost estimate in the log)
# BEDROCK_PRICE_OUT=11      # USD per million output tokens
